{
  "name": "ssr-train",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.tsx",
  "scripts": {
    "build:client": "webpack --config webpack.client.cjs",
    "build:server": "webpack --config webpack.server.cjs",
    "dev:client": "webpack serve --config webpack.client.cjs",
    "dev:server": "nodemon --watch src --ext ts,tsx,css --exec \"webpack --config webpack.server.cjs && node dist/server.js\"",
    "dev": "npm run dev:server & npm run dev:client",
    "start": "npm run build:client && npm run build:server && node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "redis": "^5.11.0",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.4",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.14",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3",
    "webpack-node-externals": "^3.0.0"
  }
}
